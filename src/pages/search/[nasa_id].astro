---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { actions } from "astro:actions";

const { nasa_id } = Astro.params;
console.log(nasa_id);
if (!nasa_id) {
  return Astro.redirect("/404");
}

// https://docs.astro.build/en/reference/api-reference/#callaction
const { data, error } = await Astro.callAction(actions.get, { id: nasa_id });

if (!data) {
  return Astro.redirect("/404");
}

if (error) {
  console.error(error);
  return Astro.redirect("/500");
}

const description = data.data[0].description;
const source = data.href;
const image = data.links.find((image) => (image.render = "image"))?.href;
---

<Base title="Hello there">
  <h2>{nasa_id}</h2>
  {
    image && description && (
      <Image src={image} alt={description} width="800" height="600" />
    )
  }
  <p>{description}</p>
  <a href={source}>Source</a>
</Base>
