---
import { Image } from "astro:assets";
import type { NasaItem, ResourceLink } from "../type/NasaType";
import type { ImageMetadata } from "astro";
import astroIcon from "@/assets/nasa/andromeda.jpg";

interface Props {
  item: NasaItem;
}

const { item } = Astro.props;

const getImageUrl = (item: NasaItem | undefined): string | ImageMetadata => {
  const findPreviewImagePredicate = (link: ResourceLink) =>
    link.rel === "preview" && link.render === "image";
  const previewImage = item?.links.find(findPreviewImagePredicate)?.href;

  const findImagePredicate = (link: ResourceLink) => link.render === "image";
  return (
    previewImage ?? item?.links.find(findImagePredicate)?.href ?? astroIcon
  );
};
---

<article>
  <header>{item.data[0].description} - ({item.data[0].nasa_id})</header>
  <Image
    src={getImageUrl(item)}
    alt="The Infrared Face of the Andromeda Galaxy"
    height="300"
    width="300"
  />
  <footer><a href={`/search/${item.data[0].nasa_id}`}>Read more...</a></footer>
</article>
