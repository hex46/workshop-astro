---
import { Image } from "astro:assets";
import type { NasaItem, ResourceLink } from "../type/NasaType";
import type { ImageMetadata } from "astro";
import astroIcon from "@/assets/nasa/andromeda.jpg";

interface Props {
  item: NasaItem;
}

const { item } = Astro.props;
---

<article>
  <header>{item.data[0].nasa_id}</header>
  {item.data[0].description}
  <footer><a href={`/search/${item.data[0].nasa_id}`}>Read more...</a></footer>
</article>
